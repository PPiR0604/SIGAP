# Server Configuration
SIGAP_AGENT_PROVIDER=gemini
SIGAP_HOST=127.0.0.1
SIGAP_PORT=8787
SIGAP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Gemini API (server only). Alternatively use ignored data/gemini.local.json.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SIGAP_GEMINI_CONFIG_PATH=

# Bob Shell / ACP Runtime
SIGAP_BOB_COMMAND=bob
SIGAP_BOB_ARGS=
SIGAP_BOB_WORKSPACE=output/bob-workspace

# Langflow & MCP Settings (Kept on backend, never exposed to browser)
SIGAP_LANGFLOW_URL=http://localhost:7860
# Path to a LOCAL populated copy of mcp/bob_mcp_config.json; keep credentials out of Git.
SIGAP_MCP_CONFIG_PATH=
# Set to 1 only after Bob is proven to request permission BEFORE each Langflow write.
SIGAP_ACP_WRITE_CONTROL_VERIFIED=0
SIGAP_SNAPSHOT_DIR=output/.sigap_snapshots

# Limits & Retention
SIGAP_MAX_INPUT_BYTES=204800
SIGAP_METADATA_RETENTION_DAYS=7
SIGAP_APPROVAL_TTL_SECONDS=3600
SIGAP_DB_PATH=data/sigap.db
