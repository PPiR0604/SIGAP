{
  "mcpServers": {
    "sigap": {
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "--with",
        "mcp<2.0.0",
        "mcp-proxy",
        "--headers",
        "x-api-key",
        "GANTI_DENGAN_LANGFLOW_API_KEY",
        "--transport",
        "streamablehttp",
        "http://localhost:7860/api/v1/mcp/project/GANTI_DENGAN_PROJECT_ID/streamable"
      ]
    }
  }
}
