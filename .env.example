# ==============================================================================
# SIGAP - TEMPLATE KONFIGURASI TUNGGAL
# Salin file ini menjadi .env dan sesuaikan nilai di bawah
# ==============================================================================

# 1. Pilihan Provider AI: 'openai' (endpoint kompatibel), 'gemini', 'mock', atau 'bob'
SIGAP_AGENT_PROVIDER=openai

# Endpoint model percakapan. Di Docker, localhost dipetakan ke host.docker.internal.
# Simpan seluruh konfigurasi model di .env root ini (diabaikan Git).
SIGAP_OPENAI_BASE_URL=http://localhost:20128/v1
SIGAP_OPENAI_MODEL=gemini/gemini-3.5-flash-lite(medium)
SIGAP_OPENAI_API_KEY=

# 2. Kredensial Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SIGAP_GEMINI_TPM_LIMIT=200000

# 3. Kredensial Langflow MCP
LANGFLOW_MCP_URL=http://localhost:7860/api/v1/mcp/project/YOUR_PROJECT_ID/streamable
LANGFLOW_API_KEY=

# 4. Token Sesi Lokal (Opsional, kosongkan untuk auto-sync)
SIGAP_SESSION_TOKEN=

# Atur pada proses Langflow (bukan hanya proses backend), atau isi path yang sama pada node reader/writer/validator.
# SIGAP_SHELTER_DB_PATH=C:/path/to/rekap_posko.sqlite3
