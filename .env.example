# ==============================================================================
# SIGAP - TEMPLATE KONFIGURASI TUNGGAL
# Salin file ini menjadi .env dan sesuaikan nilai di bawah
# ==============================================================================

# 1. Pilihan Provider AI: 'openai' (endpoint kompatibel), 'gemini', 'mock', atau 'bob'
SIGAP_AGENT_PROVIDER=openai

# Endpoint model percakapan. Di Docker, localhost dipetakan ke host.docker.internal.
# Simpan seluruh konfigurasi model di .env root ini (diabaikan Git).
SIGAP_OPENAI_BASE_URL=http://localhost:20128/v1
SIGAP_OPENAI_MODEL=oc/deepseek-v4.1-flash-free
SIGAP_OPENAI_API_KEY=

# 2. Kredensial Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SIGAP_GEMINI_TPM_LIMIT=200000

# 3. Kredensial Langflow MCP
LANGFLOW_MCP_URL=http://localhost:7860/api/v1/mcp/project/YOUR_PROJECT_ID/streamable
LANGFLOW_API_KEY=
# Cloud MCP: allow only its exact HTTPS origin. Leave empty for local-only MCP.
# LANGFLOW_MCP_URL=https://YOUR_MCP_SERVICE.vercel.app/mcp
SIGAP_MCP_ALLOWED_ORIGINS=

# 4. Supabase Auth + database (backend only; required for production startup)
SIGAP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SIGAP_SUPABASE_PUBLISHABLE_KEY=
# Must also be configured in Supabase Auth > URL Configuration.
SIGAP_AUTH_REDIRECT_URL=http://localhost:5173/
# Random secret shared by backend and the HMAC-authenticated Edge gateway. Never VITE_*.
SIGAP_SUPABASE_GATEWAY_SECRET=
SIGAP_ORGANIZATION_ID=
# Optional one-time installer allowlist. Only this verified Auth email may bootstrap the first admin.
SIGAP_BOOTSTRAP_ADMIN_EMAIL=
# On the Langflow process: URL of the backend reachable by its secure flow components.
# SIGAP_BACKEND_INTERNAL_URL=http://127.0.0.1:8787

# Atur pada proses Langflow (bukan hanya proses backend), atau isi path yang sama pada node reader/writer/validator.
# SIGAP_SHELTER_DB_PATH=C:/path/to/rekap_posko.sqlite3
